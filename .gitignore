# Dependencies and build output
node_modules/
.next/
out/

# Secrets — nothing in this project needs them today, but never let one slip in.
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Local tool state (machine-specific, not part of the deliverable)
.claude/settings.local.json

# Internal working documents — kept on the studio machine, not in the deploy repo.
# README.md holds the handover notes, the outstanding-questions table and the
# photo-rights position; CLAUDE.md holds working instructions.
README.md
CLAUDE.md

# Photo harvest record and the scripts that produced it. Not needed to build or
# deploy; held alongside the _originals archive outside the repo.
assets/photo-provenance.json
scripts/fetch-photos.mjs
scripts/receive-photos.mjs

# Generated from assets/images/ on every build by scripts/optimise-images.mjs.
# Both `npm run dev` and `npm run build` regenerate them, so a fresh clone works.
public/img/
lib/image-manifest.json

# Generated by scripts/generate-brand-assets.mjs from assets/images/hero-interior.jpg
public/favicon.svg
public/favicon-32.png
public/favicon-96.png
public/apple-touch-icon.png
public/icon-512.png
public/og.jpg

# Generated by scripts/generate-seo-files.mjs from lib/site.js and lib/copy.js
public/robots.txt
public/sitemap.xml
public/llms.txt
public/manifest.webmanifest
public/_headers

# The 42-image harvest archive. Deliberately NOT committed:
#   - the build never reads it (only assets/images/*.jpg, non-recursive)
#   - it is 21MB of photographs whose rights are not cleared
# It is held outside the repo. See the Images section of README.md.
assets/images/_originals/

# Scratch output from the photo contact sheet.
contact-sheet.jpg
andre-check.jpg
